rules_version = '2';

// SpazaLink Firebase Storage Security Rules
// Phase 2
//
// Bucket structure:
//   shop_photos/{shopId}/{filename}         — shop logos and photos
//   documents/{shopId}/{docType}/{filename} — business reg, owner ID
//   product_images/{productId}/{filename}   — product images (admin only)
//   category_icons/{categoryId}/{filename}  — category icons (admin only)
//   driver_photos/{driverId}/{filename}     — driver profile photo
//   delivery_proofs/{deliveryId}/{filename} — proof-of-delivery photos
//   delivery_signatures/{deliveryId}/{sig}  — signature captures
//   banners/{filename}                      — promotional banners
//   invoices/{shopId}/{orderId}/{filename}  — generated invoices

service firebase.storage {
  match /b/{bucket}/o {

    // ── Helpers ───────────────────────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
          .data.get('role', '') == 'admin';
    }

    function isDriver() {
      return isAuth() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid))
          .data.get('role', '') == 'driver';
    }

    function isShopOwner(shopId) {
      return isAuth() &&
        firestore.get(/databases/(default)/documents/shops/$(shopId))
          .data.ownerId == request.auth.uid;
    }

    function isAssignedDriver(deliveryId) {
      return isDriver() &&
        firestore.get(/databases/(default)/documents/deliveries/$(deliveryId))
          .data.driverId == request.auth.uid;
    }

    // Max file size checks
    function isImageFile() {
      return request.resource.contentType.matches('image/.*');
    }

    function isUnder5MB() {
      return request.resource.size <= 5 * 1024 * 1024;
    }

    function isUnder2MB() {
      return request.resource.size <= 2 * 1024 * 1024;
    }

    function isUnder10MB() {
      return request.resource.size <= 10 * 1024 * 1024;
    }

    // ── Shop Photos ───────────────────────────────────────────────────────────

    match /shop_photos/{shopId}/{filename} {
      allow read: if isAuth();
      allow write: if isShopOwner(shopId) && isImageFile() && isUnder5MB();
    }

    // ── Shop Documents (business reg, owner ID) ───────────────────────────────

    match /documents/{shopId}/{docType}/{filename} {
      allow read: if isAuth() && (isShopOwner(shopId) || isAdmin());
      allow write: if isShopOwner(shopId) && isUnder10MB();
    }

    // ── Product Images (admin only) ───────────────────────────────────────────

    match /product_images/{productId}/{filename} {
      allow read: if isAuth();
      allow write: if isAdmin() && isImageFile() && isUnder5MB();
    }

    // ── Category Icons (admin only) ───────────────────────────────────────────

    match /category_icons/{categoryId}/{filename} {
      allow read: if isAuth();
      allow write: if isAdmin() && isImageFile() && isUnder2MB();
    }

    // ── Driver Photos ─────────────────────────────────────────────────────────

    match /driver_photos/{driverId}/{filename} {
      allow read: if isAuth();
      allow write: if isAuth() && (request.auth.uid == driverId || isAdmin())
                      && isImageFile() && isUnder5MB();
    }

    // ── Delivery Proof Photos ─────────────────────────────────────────────────

    match /delivery_proofs/{deliveryId}/{filename} {
      allow read: if isAuth() && (
        isAssignedDriver(deliveryId) ||
        isAdmin() ||
        firestore.get(/databases/(default)/documents/deliveries/$(deliveryId))
          .data.customerId == request.auth.uid
      );
      allow write: if isAssignedDriver(deliveryId) && isImageFile() && isUnder10MB();
    }

    // ── Delivery Signatures ───────────────────────────────────────────────────

    match /delivery_signatures/{deliveryId}/{filename} {
      allow read: if isAuth() && (isAssignedDriver(deliveryId) || isAdmin());
      allow write: if isAssignedDriver(deliveryId) && isUnder2MB();
    }

    // ── Promotional Banners ───────────────────────────────────────────────────

    match /banners/{filename} {
      allow read: if isAuth();
      allow write: if isAdmin() && isImageFile() && isUnder5MB();
    }

    // ── Invoices ──────────────────────────────────────────────────────────────

    match /invoices/{shopId}/{orderId}/{filename} {
      allow read: if isAuth() && (isShopOwner(shopId) || isAdmin());
      allow write: if isAdmin(); // Generated by Cloud Functions
    }
  }
}
